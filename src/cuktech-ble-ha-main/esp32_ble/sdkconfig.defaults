# BT — NimBLE host on CPU 1 (CPU 0 is WiFi/TCP-IP)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL=4
# NimBLE memory tuning — single-device, relaxed enough for service discovery
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=255
CONFIG_BT_NIMBLE_TRANSPORT_EVT_SIZE=256
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=8
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
# ATT_PREFERRED_MTU left at default (256)

# MQTT
CONFIG_MQTT_PROTOCOL_311=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# HTTP Server (prevent ENFILE fd exhaustion)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# LWIP
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_TCP_WND_DEFAULT=4096
CONFIG_LWIP_TCP_MSS=1460
# LWIP internal memory — prevent TCP depletion under fragmentation
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072
# Disable OOSEQ to reduce per-connection memory when fragmented
CONFIG_LWIP_TCP_QUEUE_OOSEQ=n
# TCP keep-alive for MQTT long-lived connections
CONFIG_LWIP_SO_REUSE=n

# mbedTLS (for crypto)
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_HKDF_C=y

# --- Stability ---
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
# Task WDT: init + panic on timeout (detect/restart on task deadlock)
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
